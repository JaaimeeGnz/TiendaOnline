---
/**
 * src/pages/admin/productos/fotos-masivo.astro
 * Página para agregar fotos a múltiples productos a la vez
 */
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { supabaseClient } from '../../../lib/supabase';

// Obtener productos sin imágenes (para mostrar cuáles necesitan)
const { data: productsWithoutImages } = await supabaseClient
  .from('products')
  .select('id, name, slug, images')
  .filter('images', 'is', null)
  .order('created_at', { ascending: false });

const { data: allProducts } = await supabaseClient
  .from('products')
  .select('id, name, slug, images')
  .order('created_at', { ascending: false });

const productsWithImages = allProducts?.filter(p => p.images && p.images.length > 0) || [];
const productsWithoutImagesCount = productsWithoutImages?.length || 0;
const productsWithImagesCount = productsWithImages.length || 0;
---

<AdminLayout title="Agregar Fotos Masivo">
  <div class="mb-8">
    <h1 class="text-3xl font-bold text-primary-800">Agregar Fotos a Productos</h1>
    <p class="text-neutral-gray_dark mt-1">Carga imágenes para múltiples productos fácilmente</p>
  </div>

  <!-- Estadísticas -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
      <div class="text-3xl font-bold text-blue-600">{allProducts?.length || 0}</div>
      <p class="text-sm text-blue-700 mt-2">Total de Productos</p>
    </div>
    <div class="bg-red-50 border border-red-200 rounded-lg p-6">
      <div class="text-3xl font-bold text-red-600">{productsWithoutImagesCount}</div>
      <p class="text-sm text-red-700 mt-2">Sin Imágenes</p>
    </div>
    <div class="bg-green-50 border border-green-200 rounded-lg p-6">
      <div class="text-3xl font-bold text-green-600">{productsWithImagesCount}</div>
      <p class="text-sm text-green-700 mt-2">Con Imágenes</p>
    </div>
  </div>

  <!-- Opción 1: Editar productos individuales -->
  <div class="bg-white border border-primary-200 rounded-lg p-8 mb-8">
    <h2 class="text-xl font-bold text-primary-800 mb-4">Opción 1: Editar Productos Individuales</h2>
    <p class="text-neutral-gray_dark mb-6">
      Haz clic en cualquier producto para editarlo y agregar fotos
    </p>
    
    {productsWithoutImagesCount > 0 ? (
      <div class="space-y-3">
        <h3 class="font-bold text-sm text-red-700">Productos que necesitan fotos:</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
          {productsWithoutImages?.map((product) => (
            <a
              href={`/admin/productos/${product.id}`}
              class="block p-4 border border-red-200 bg-red-50 rounded hover:bg-red-100 transition"
            >
              <p class="font-bold text-red-800">{product.name}</p>
              <p class="text-xs text-red-600 mt-1">👉 Editar para agregar fotos</p>
            </a>
          ))}
        </div>
      </div>
    ) : (
      <div class="p-4 bg-green-50 border border-green-200 rounded">
        <p class="text-green-700 font-bold">✅ ¡Todos los productos tienen imágenes!</p>
      </div>
    )}
  </div>

  <!-- Opción 2: Instrucciones para agregar fotos -->
  <div class="bg-white border border-primary-200 rounded-lg p-8">
    <h2 class="text-xl font-bold text-primary-800 mb-6">Pasos para Agregar Fotos</h2>
    
    <div class="space-y-6">
      <!-- Paso 1 -->
      <div class="flex gap-4">
        <div class="flex items-center justify-center w-10 h-10 bg-primary-800 text-white rounded-full font-bold text-sm flex-shrink-0">
          1
        </div>
        <div>
          <h3 class="font-bold text-primary-800 mb-2">Selecciona un Producto</h3>
          <p class="text-neutral-gray_dark text-sm">
            En el listado anterior, haz clic en "Editar" en el producto al que deseas agregar fotos
          </p>
        </div>
      </div>

      <!-- Paso 2 -->
      <div class="flex gap-4">
        <div class="flex items-center justify-center w-10 h-10 bg-primary-800 text-white rounded-full font-bold text-sm flex-shrink-0">
          2
        </div>
        <div>
          <h3 class="font-bold text-primary-800 mb-2">Haz Clic en "📷 Subir Imágenes con Cloudinary"</h3>
          <p class="text-neutral-gray_dark text-sm">
            Se abrirá una ventana para seleccionar imágenes de tu computadora
          </p>
        </div>
      </div>

      <!-- Paso 3 -->
      <div class="flex gap-4">
        <div class="flex items-center justify-center w-10 h-10 bg-primary-800 text-white rounded-full font-bold text-sm flex-shrink-0">
          3
        </div>
        <div>
          <h3 class="font-bold text-primary-800 mb-2">Arrastra o Selecciona Imágenes</h3>
          <p class="text-neutral-gray_dark text-sm">
            Puedes arrastrar múltiples imágenes o hacer clic para seleccionar. Formatos: JPG, PNG, WebP (máx 5MB)
          </p>
        </div>
      </div>

      <!-- Paso 4 -->
      <div class="flex gap-4">
        <div class="flex items-center justify-center w-10 h-10 bg-primary-800 text-white rounded-full font-bold text-sm flex-shrink-0">
          4
        </div>
        <div>
          <h3 class="font-bold text-primary-800 mb-2">Espera a que Suban</h3>
          <p class="text-neutral-gray_dark text-sm">
            Cloudinary subirá las imágenes automáticamente. Verás una vista previa de cada una
          </p>
        </div>
      </div>

      <!-- Paso 5 -->
      <div class="flex gap-4">
        <div class="flex items-center justify-center w-10 h-10 bg-primary-800 text-white rounded-full font-bold text-sm flex-shrink-0">
          5
        </div>
        <div>
          <h3 class="font-bold text-primary-800 mb-2">Guarda los Cambios</h3>
          <p class="text-neutral-gray_dark text-sm">
            Haz clic en "Guardar Cambios" para actualizar el producto con las nuevas imágenes
          </p>
        </div>
      </div>
    </div>
  </div>

  <!-- Consejos -->
  <div class="mt-8 p-6 bg-blue-50 border border-blue-200 rounded-lg">
    <h3 class="font-bold text-blue-800 mb-3">💡 Consejos</h3>
    <ul class="space-y-2 text-sm text-blue-700">
      <li>✅ Sube al menos 1 imagen por producto</li>
      <li>✅ Usa imágenes de buena calidad (JPG o PNG)</li>
      <li>✅ Intenta usar imágenes cuadradas (1:1) para mejor presentación</li>
      <li>✅ Las imágenes se optimizan automáticamente en Cloudinary</li>
      <li>✅ Puedes subir múltiples imágenes del mismo producto a la vez</li>
      <li>✅ Las imágenes se servirán desde CDN global (muy rápido)</li>
    </ul>
  </div>

  <!-- Botón rápido -->
  <div class="mt-8 flex gap-4">
    <a
      href="/admin/productos"
      class="px-6 py-3 bg-primary-800 text-white font-semibold rounded hover:bg-primary-900 transition"
    >
      ← Volver a Productos
    </a>
  </div>
</AdminLayout>
