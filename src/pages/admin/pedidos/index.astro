  <script type="module">
    // Configurar event listeners cuando la página carga
    function setupOrderButtons() {
      console.log('⚙️ Configurando botones de pedidos');
      const buttons = document.querySelectorAll('.update-status-btn');
      console.log('📊 Botones encontrados:', buttons.length);

      buttons.forEach((btn, index) => {
        const orderId = btn.getAttribute('data-order-id');
        const status = btn.getAttribute('data-status');
        console.log(`Botón ${index}: orderId="${orderId}", status="${status}"`);

        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          
          const clickedOrderId = btn.getAttribute('data-order-id');
          const clickedStatus = btn.getAttribute('data-status');
          
          console.log('🔄 Click en botón - orderId:', clickedOrderId, 'status:', clickedStatus);
          
          if (!clickedOrderId || !clickedStatus) {
            showErrorModal('Error: Datos del pedido incompletos');
            return;
          }
          
          // Obtener el mensaje de estado seleccionado (si existe)
          const messageSelect = document.querySelector(`select[data-order-id="${clickedOrderId}"]`);
          let message = '';
          if (messageSelect) {
            const selectedValue = messageSelect.value;
            const selectedText = messageSelect.options[messageSelect.selectedIndex].text;
            message = selectedValue && selectedValue !== 'custom' ? selectedText : '';
          }
          
          try {
            const payload = { 
              action: 'update-status', 
              orderId: clickedOrderId, 
              status: clickedStatus,
              message: message
            };
            console.log('📤 Enviando:', JSON.stringify(payload));
            
            const response = await fetch('/api/admin/orders', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(payload)
            });

            const responseData = await response.json();
            console.log('📥 Respuesta:', responseData);

            if (!response.ok) {
              showErrorModal(responseData.error || 'Error al actualizar el pedido');
              return;
            }

            const statusText = clickedStatus === 'processing' ? 'procesamiento' : 
                              clickedStatus === 'completed' ? 'entregado' : 'pendiente';
            
            await showSuccessModal(`Pedido marcado como ${statusText}${message ? '. Mensaje enviado al cliente.' : ''}`);
            window.location.reload();
          } catch (error) {
            showErrorModal('Error al actualizar el pedido');
            console.error('❌ Error:', error);
          }
        });
      });
    }

    // Configurar botones de guardar mensaje
    function setupSaveMessageButtons() {
      console.log('⚙️ Configurando botones de guardar mensaje');
      const saveButtons = document.querySelectorAll('.save-message-btn');
      console.log('💾 Botones de guardar encontrados:', saveButtons.length);

      saveButtons.forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          
          const orderId = btn.getAttribute('data-order-id');
          const messageSelect = document.querySelector(`select[data-order-id="${orderId}"]`);
          
          if (!messageSelect || !messageSelect.value) {
            showErrorModal('Por favor selecciona un mensaje antes de guardar');
            return;
          }
          
          const message = messageSelect.options[messageSelect.selectedIndex].text;
          
          try {
            const payload = { 
              action: 'save-message', 
              orderId: orderId, 
              message: message
            };
            console.log('📤 Guardar mensaje:', JSON.stringify(payload));
            
            const response = await fetch('/api/admin/orders', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(payload)
            });

            const responseData = await response.json();
            console.log('📥 Respuesta:', responseData);

            if (!response.ok) {
              showErrorModal(responseData.error || 'Error al guardar el mensaje');
              return;
            }

            await showSuccessModal('Mensaje guardado exitosamente y visible para el cliente');
            // Limpiar selector atrás
            messageSelect.value = '';
          } catch (error) {
            showErrorModal('Error al guardar el mensaje');
            console.error('❌ Error:', error);
          }
        });
      });
    }

    function showSuccessModal(message) {
      return new Promise((resolve) => {
        const overlay = document.createElement('div');
        overlay.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
        
        const modal = document.createElement('div');
        modal.className = 'bg-white rounded-lg p-8 max-w-md w-full shadow-xl';
        modal.innerHTML = `
          <div class="flex items-center justify-center mb-4">
            <svg class="w-12 h-12 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-4 text-center">¡Éxito!</h2>
          <p class="text-gray-600 mb-6 text-center">${message}</p>
          <button id="close-btn" class="w-full px-6 py-2 bg-green-600 text-white font-semibold rounded-lg hover:bg-green-700 transition">
            Aceptar
          </button>
        `;
        
        overlay.appendChild(modal);
        document.body.appendChild(overlay);
        
        document.getElementById('close-btn').addEventListener('click', () => {
          overlay.remove();
          resolve(true);
        });
      });
    }

    function showErrorModal(message) {
      return new Promise((resolve) => {
        const overlay = document.createElement('div');
        overlay.className = 'fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-50';
        
        const modal = document.createElement('div');
        modal.className = 'bg-white rounded-lg p-8 max-w-md w-full shadow-xl';
        modal.innerHTML = `
          <div class="flex items-center justify-center mb-4">
            <svg class="w-12 h-12 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
          </div>
          <h2 class="text-xl font-bold text-gray-900 mb-4 text-center">Error</h2>
          <p class="text-gray-600 mb-6 text-center">${message}</p>
          <button id="close-btn" class="w-full px-6 py-2 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-700 transition">
            Aceptar
          </button>
        `;
        
        overlay.appendChild(modal);
        document.body.appendChild(overlay);
        
        document.getElementById('close-btn').addEventListener('click', () => {
          overlay.remove();
          resolve(true);
        });
      });
    }

    // Modal de confirmación de eliminación (bonito)
    function showDeleteConfirmModal(orderId, orderNumber, orderTotal) {
      return new Promise((resolve) => {
        const overlay = document.createElement('div');
        overlay.className = 'fixed inset-0 bg-black bg-opacity-60 flex items-center justify-center z-50';
        overlay.style.backdropFilter = 'blur(4px)';
        
        const modal = document.createElement('div');
        modal.className = 'bg-white rounded-2xl p-8 max-w-md w-full shadow-2xl transform transition-all';
        modal.innerHTML = `
          <div class="flex items-center justify-center mb-6">
            <div class="w-20 h-20 bg-red-100 rounded-full flex items-center justify-center">
              <svg class="w-10 h-10 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
              </svg>
            </div>
          </div>
          <h2 class="text-2xl font-black text-gray-900 mb-3 text-center">¿Eliminar pedido?</h2>
          <p class="text-gray-500 mb-6 text-center text-sm">Esta acción no se puede deshacer. Se eliminará permanentemente el pedido y todos sus datos asociados.</p>
          
          <div class="bg-red-50 border-2 border-red-200 rounded-xl p-4 mb-6">
            <div class="flex justify-between items-center mb-2">
              <span class="text-sm font-bold text-gray-700">Pedido</span>
              <span class="text-sm font-black text-red-600">#${orderNumber}</span>
            </div>
            <div class="flex justify-between items-center">
              <span class="text-sm font-bold text-gray-700">Total</span>
              <span class="text-sm font-black text-red-600">${orderTotal}€</span>
            </div>
          </div>

          <div class="flex gap-3">
            <button id="cancel-delete-btn" class="flex-1 px-6 py-3 bg-gray-100 text-gray-700 font-bold rounded-xl hover:bg-gray-200 active:scale-95 transition text-sm">
              Cancelar
            </button>
            <button id="confirm-delete-btn" class="flex-1 px-6 py-3 bg-red-600 text-white font-bold rounded-xl hover:bg-red-700 active:scale-95 transition text-sm">
              🗑️ Sí, eliminar
            </button>
          </div>
        `;
        
        overlay.appendChild(modal);
        document.body.appendChild(overlay);
        
        // Animación de entrada
        modal.style.opacity = '0';
        modal.style.transform = 'scale(0.9)';
        requestAnimationFrame(() => {
          modal.style.transition = 'all 0.2s ease-out';
          modal.style.opacity = '1';
          modal.style.transform = 'scale(1)';
        });

        document.getElementById('cancel-delete-btn').addEventListener('click', () => {
          overlay.remove();
          resolve(false);
        });
        
        document.getElementById('confirm-delete-btn').addEventListener('click', () => {
          overlay.remove();
          resolve(true);
        });

        // Cerrar al hacer clic fuera
        overlay.addEventListener('click', (e) => {
          if (e.target === overlay) {
            overlay.remove();
            resolve(false);
          }
        });
      });
    }

    // Configurar botones de eliminar pedido
    function setupDeleteButtons() {
      console.log('⚙️ Configurando botones de eliminar pedido');
      const deleteButtons = document.querySelectorAll('.delete-order-btn');
      console.log('🗑️ Botones de eliminar encontrados:', deleteButtons.length);

      deleteButtons.forEach((btn) => {
        btn.addEventListener('click', async (e) => {
          e.preventDefault();
          
          const orderId = btn.getAttribute('data-order-id');
          const orderNumber = btn.getAttribute('data-order-number') || orderId.slice(0, 8).toUpperCase();
          const orderTotal = btn.getAttribute('data-order-total') || '0.00';
          
          // Mostrar modal de confirmación bonito
          const confirmed = await showDeleteConfirmModal(orderId, orderNumber, orderTotal);
          
          if (!confirmed) return;
          
          // Deshabilitar botón mientras se procesa
          btn.disabled = true;
          btn.textContent = '⏳ Eliminando...';
          
          try {
            const payload = { 
              action: 'delete-order', 
              orderId: orderId
            };
            console.log('📤 Eliminar pedido:', JSON.stringify(payload));
            
            const response = await fetch('/api/admin/orders', {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
              },
              body: JSON.stringify(payload)
            });

            const responseData = await response.json();
            console.log('📥 Respuesta:', responseData);

            if (!response.ok) {
              showErrorModal(responseData.error || 'Error al eliminar el pedido');
              btn.disabled = false;
              btn.textContent = '🗑️ Eliminar';
              return;
            }

            await showSuccessModal(`Pedido #${orderNumber} eliminado correctamente`);
            window.location.reload();
          } catch (error) {
            showErrorModal('Error al eliminar el pedido');
            btn.disabled = false;
            btn.textContent = '🗑️ Eliminar';
            console.error('❌ Error:', error);
          }
        });
      });
    }

    // Configurar botones cuando el DOM esté listo
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => {
        setupOrderButtons();
        setupSaveMessageButtons();
        setupDeleteButtons();
      });
    } else {
      setupOrderButtons();
      setupSaveMessageButtons();
      setupDeleteButtons();
    }
  </script>
</AdminLayout>
